generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  username        String?
  displayUsername String?
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?

  active Boolean? @default(false)

  surname    String
  patronymic String?
  positionId String?

  position UserPosition? @relation(fields: [positionId], references: [id])

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model UserPosition {
  id    String @id @default(uuid())
  name  String
  users User[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/**
 */

model Complex {
  id         String          @id @default(uuid())
  name       String
  subObjects SubObjectBase[]

  // @@map("residential_complex")
}

model SubObjectBase {
  id           String        @id @default(uuid())
  name         String
  // coordinates Float[]
  geometry     Json
  type         SubObjectType
  buildAddress String
  postAddress  String
  payer        String

  complexId String
  complex   Complex @relation(fields: [complexId], references: [id])

  apartmentDetails MKD?
  garageDetails    Garage?
  odhDetails       ODH?

  @@index([complexId])
}

enum SubObjectType {
  MKD
  ODH
  GARAGE
}

model MKD {
  // main

  id              String        @id @default(uuid())
  // address         String
  subObjectBaseId String        @unique
  subObjectBase   SubObjectBase @relation(fields: [subObjectBaseId], references: [id])

  // char-s
  buildingFootprintArea Float? //Площадь застройки дома	
  sectionsCount         Int? // Кол-во секций	
  floorsCount           Int? // Кол-во этажей
  elevatorsCount        Int? // Кол-во лифтов
  garbageChamberCount   Int? // Кол-во мусорокамер
  commonAreaFloor1      Float? // МОП 1 этажа
  commonAreaFloor2Plus  Float? // МОП выше 2 этажа
  commonAreaStorage     Float? // МОП Кладовых
  technicalRoomsArea    Float? // Площадь тех. помещений
  odsArea               Float? // Площадь ОДС
  garbageChamberArea    Float? // Площадь мусорокамер
  cleaningStaffCount    Int? // Кол-во сотрудников (Уборщик МОП)
  cleaningFrequency     String? // Периодичность уборки МОП

  // parking
  parking Parking?

  // territory
  territory MKDTerritory?
}

// MKD RElated
model MKDTerritory {
  id    String @id @default(uuid())
  mkdId String @unique
  mkd   MKD    @relation(fields: [mkdId], references: [id])

  totalArea                Float? // Общая площадь
  manualCleaningArea       Float? // Ручная уборка
  greeningArea             Float? // Площадь озеленения
  mechanizedCleaningArea   Float? // Механизированная уборка
  cleaningStaffCountSummer Int? // Кол-во сотрудников - Летний период
  equipmentCountSummer     Int? // Кол-во техники - Летний период
  cleaningStaffCountWinter Int? // Кол-во сотрудников - Зимний период
  equipmentCountWinter     Int? // Кол-во техники - Зимний период
}

// mkd related
model Parking {
  id    String @id @default(uuid())
  mkdId String @unique
  mkd   MKD    @relation(fields: [mkdId], references: [id])

  parkingSpacesCount        Int? // Кол-во машиномест
  floorsCount               Int? // Кол-во этажей (подземных)
  elevatorHallStaircaseArea Float? // Уборочная площадь лифтового холла + лестничная клетка
  parkingSpacesCleaningArea Float? // Уборочная площадь машиномест
  drivewaysRampArea         Float? // Уборочная площадь проездов + рамп
  technicalRoomsArea        Float? // Площадь тех. помещений
  cleaningStaffCountSummer  Int? // Кол-во сотрудников - Летний период
  cleaningStaffCountWinter  Int? // Кол-во сотрудников - Зимний период
  cleaningFrequencySummer   String? // Периодичность уборки - Летний период
  cleaningFrequencyWinter   String? // Периодичность уборки - Зимний период
}

model Garage {
  id              String        @id @default(uuid())
  // address         String
  subObjectBaseId String        @unique
  subObjectBase   SubObjectBase @relation(fields: [subObjectBaseId], references: [id])

  parkingSpacesCount        Int? // Кол-во машиномест
  floorsCount               Int? // Кол-во этажей
  elevatorHallStaircaseArea Float? // Уборочная площадь лифтового холла + лестничная клетка
  parkingSpacesCleaningArea Float? // Уборочная площадь машиномест
  drivewaysRampArea         Float? // Уборочная площадь проездов + рамп
  technicalRoomsArea        Float? // Площадь тех. помещений
  elevatorsCount            Int? // Кол-во лифтов
  cleaningStaffCountSummer  Int? // Кол-во сотрудников - Летний период
  cleaningStaffCountWinter  Int? // Кол-во сотрудников - Зимний период
  cleaningFrequencySummer   String? // Периодичность уборки МОП - Летний период
  cleaningFrequencyWinter   String? // Периодичность уборки МОП - Зимний период

  // Прилегающая территория гаража
  territory GarageTerritory?
}

// garage related
model GarageTerritory {
  id       String @id @default(uuid())
  garageId String @unique
  garage   Garage @relation(fields: [garageId], references: [id])

  totalArea                Float? // Общая площадь
  manualCleaningArea       Float? // Ручная уборка
  greeningArea             Float? // Площадь озеленения
  mechanizedCleaningArea   Float? // Механизированная уборка
  cleaningStaffCountSummer Int? // Кол-во сотрудников - Летний период
  equipmentCountSummer     Int? // Кол-во техники - Летний период
  cleaningStaffCountWinter Int? // Кол-во сотрудников - Зимний период
  equipmentCountWinter     Int? // Кол-во техники - Зимний период
}

model ODH {
  id              String        @id @default(uuid())
  // address         String
  subObjectBaseId String        @unique
  subObjectBase   SubObjectBase @relation(fields: [subObjectBaseId], references: [id])

  totalArea                Float? // Общая площадь
  manualCleaningArea       Float? // Ручная уборка
  greeningArea             Float? // Площадь озеленения
  mechanizedCleaningArea   Float? // Механизированная уборка
  cleaningStaffCountSummer Int? // Кол-во сотрудников - Летний период
  equipmentCountSummer     Int? // Кол-во техники - Летний период
  cleaningStaffCountWinter Int? // Кол-во сотрудников - Зимний период
  equipmentCountWinter     Int? // Кол-во техники - Зимний период
}
